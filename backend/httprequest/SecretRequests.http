###
#Get all secrets
GET http://localhost:8080/api/secrets
Accept: application/json

###
# Create new secret
POST http://localhost:8080/api/secrets
Content-Type: application/json

{
  "email": "hans.muster@bbw.ch",
  "content": {
    "kindid": 3,
    "kind": "note",
    "title": "Spaphira",
    "content": "Saphira roch an dem kleinen Erdling."
  },
  "encryptPassword": "xxxyyy"
}

###
#Post to get secrets with userUuid and encryptpassword
POST http://localhost:8080/api/secrets/byuseruuid
Content-Type: application/json

{
  "userUuid": "11111111-1111-4111-8111-111111111111",
  "encryptPassword": "xxxyyy"
}

###
#Post to get secrets with email and encryptpassword
POST http://localhost:8080/api/secrets/byemail
Content-Type: application/json

{
  "email": "hans.muster@bbw.ch",
  "encryptPassword": "xxxyyy"
}

###
# Update secret with secretUuid
PUT http://localhost:8080/api/secrets/cccccccc-cccc-4ccc-8ccc-cccccccccccc
Content-Type: application/json

{
  "email": "hans.muster@bbw.ch",
  "content": {
    "kindid": 3,
    "kind": "note",
    "title": "Red drageon",
    "content": "Er war gewaltig und rot."
  },
  "encryptPassword": "xxxyyy"
}

###
#Delete secret with secretUuid
DELETE http://localhost:8080/api/secrets/cccccccc-cccc-4ccc-8ccc-cccccccccccc
Accept: application/json
Content-Type: application/json

{
  "email": "hans.muster@bbw.ch",
  "encryptPassword": "xxxyyy"
}

###
#Delete secret with secretUuid
DELETE http://localhost:8080/api/secrets/bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
Accept: application/json
Content-Type: application/json

{
  "email": "hans.muster@bbw.ch",
  "encryptPassword": "xxxyyy"
}

###
#Delete secret with secretUuid
DELETE http://localhost:8080/api/secrets/aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
Accept: application/json
Content-Type: application/json

{
  "email": "hans.muster@bbw.ch",
  "encryptPassword": "xxxyyy"
}
